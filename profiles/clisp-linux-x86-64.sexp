(:name "clisp-linux-x86-64"
 :source "captured from CLISP 2.49.93+ (2018-02-18) on linux x86-64"
 :features (:readline :regexp :wildcard :syscalls :i18n :loop :compiler :clos :mop :clisp
            :ansi-cl :common-lisp :lisp=cl :interpreter :logical-pathnames :sockets
            :generic-streams :screen :ffi :gettext :unicode :base-char=character
            :word-size=64 :pc386 :unix))
