(:name "ccl-linux-x86-64"
 :source "approximate, written by hand; regenerate with dump-features.lisp"
 :features (:clozure :clozure-common-lisp :ansi-cl :unix :openmcl-unicode-strings :ipv6
            :openmcl-native-threads :openmcl-partial-mop :mcl-common-mop-subset :openmcl-mop-2
            :openmcl-private-hash-tables :x86-64 :x86_64 :x86-target :x86-host :x8664-target
            :x8664-host :linux-host :linux-target :linuxx86-target :linuxx8664-target
            :linuxx8664-host :little-endian-target :little-endian-host :64-bit-target :64-bit-host
            :linux :ccl :ccl-1.12 :ccl-1.13 :common-lisp :package-local-nicknames))
