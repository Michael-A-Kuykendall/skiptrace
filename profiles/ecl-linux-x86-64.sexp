(:name "ecl-linux-x86-64"
 :source "captured from ECL 21.2.1"
 :features (:walker :cdr-1 :cdr-5 :linux :formatter :cdr-7 :ecl-weak-hash
            :little-endian :ecl-read-write-lock :long-long :uint64-t :uint32-t
