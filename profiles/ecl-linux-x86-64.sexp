            :cmu-format :unix :ecl-pde :dlopen :clos :threads :boehm-gc
            :ansi-cl :common-lisp :floating-point-exceptions
            :ieee-floating-point :package-local-nicknames :cdr-14 :prefixed-api
            :ffi :x86_64 :common :ecl))
